# Copy this file to .env and change the values there. .env is never committed.
SB_ENVIRONMENT=local
SB_LOG_LEVEL=INFO
# AI model: provider "ollama" (default) or "openai" (any OpenAI-compatible server)
SB_LLM_PROVIDER=ollama
SB_LLM_MODEL=qwen3:4b
# Review loop (Lab 24): how often a portfolio answer may be sent back for correction
SB_MAX_REVISIONS=2
# Failed tool calls one question may have before the desk gives up (Lab 43)
SB_MAX_TOOL_RETRIES=2
# Decisions the team supervisor may make for one request (Lab 51)
SB_TEAM_MAX_TURNS=6
# New plans after failed steps, per planned task (Lab 56)
SB_PLANNER_MAX_REPLANS=2
# Team cases shared between graphs (Lab 54): "memory" or "redis"; minutes a case is kept
SB_SHARED_STATE_STORE=memory
SB_CASE_TTL_MINUTES=1440
# Who chooses the research track (Lab 30): "model" (default) or "rules"
SB_RESEARCH_ROUTER=model
# Database (PostgreSQL in Compose; local development password only)
SB_DATABASE_URL=postgresql+psycopg://sb:sb_local_pw@localhost:5432/sovereign_brain
# Sign-in tokens: replace with your own random value (see Lab 16)
SB_JWT_SECRET=replace-me-with-a-long-random-value-of-at-least-32-characters
# Model calls per analyst (Lab 17)
SB_MODEL_RATE_LIMIT=5/minute
# Redis cache (Lab 18); the API in Compose uses the redis service instead
SB_REDIS_URL=redis://localhost:6379/0
# Semantic memory in Qdrant (Lab 38): set to false if you cannot run Qdrant
SB_SEMANTIC_MEMORY=true
SB_QDRANT_URL=http://localhost:6333
# Older thread messages the model reads with each question (Lab 40)
SB_HISTORY_LIMIT=20
# MCP servers started by the API (Lab 44), as a JSON list; [] switches MCP off
SB_MCP_SERVERS=["desk", "notes", "market"]
# MCP servers only the software agency uses (Lab 60)
SB_AGENCY_MCP_SERVERS=["workspace"]
# Internal market-data API (Lab 46): replace the token with your own random value
SB_MARKET_API_URL=http://localhost:8100
# (Lab 75: once Vault runs, the market token comes from Vault; this line is only for local runs)
SB_MARKET_API_TOKEN=replace-me-with-a-long-random-market-token
# Code sandbox (Lab 47); the API in Compose reaches it at http://sandbox:8200
SB_SANDBOX_URL=http://localhost:8200
# Long-document analysis (Lab 57): piece size, collapse size, readers at the same time
SB_MAP_CHUNK_CHARS=1200
SB_MAP_COLLAPSE_CHARS=2000
SB_MAP_MAX_CONCURRENCY=4
# Released reports (Lab 61): one JSON file per report in this folder
SB_OUTBOX_DIR=data/outbox
# Tracing (Lab 66): the API in Compose sends traces to the Collector; local runs and tests don't
SB_OTEL_ENABLED=false
# LangSmith (Lab 67, optional): hosted traces of every graph run; needs a free account.
# Use synthetic data only. LANGSMITH_HIDE_INPUTS/OUTPUTS=true keep prompts and answers private.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sovereign-brain
# Grafana (Lab 69): admin password, and the token its alerts send to the API
SB_GRAFANA_ADMIN_PASSWORD=replace-me-with-a-grafana-password
SB_ALERT_WEBHOOK_TOKEN=replace-me-with-a-long-random-alert-token
# Personal data (Lab 72): mask names, e-mails, IBANs ... before the model reads a question
SB_PII_MASKING=true
# HashiCorp Vault (Lab 75): the root token is for the dev server and scripts/vault_setup.py;
# the role ID and secret ID are the API's own login (choose long random values)
SB_VAULT_ROOT_TOKEN=replace-me-with-a-vault-root-token
SB_VAULT_ROLE_ID=replace-me-with-a-random-role-id
SB_VAULT_SECRET_ID=replace-me-with-a-random-secret-id
# NVIDIA NIM (Lab 92, optional). GPU path: your NGC API key for nvcr.io and the NIM container.
# Hosted path (no GPU): an API key from build.nvidia.com; prompts then leave your computer.
NGC_API_KEY=
SB_NIM_BASE_URL=http://localhost:8002/v1
SB_NIM_API_KEY=not-needed
SB_NIM_MODEL=meta/llama-3.1-8b-instruct
