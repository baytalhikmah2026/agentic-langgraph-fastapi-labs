SB_ENVIRONMENT=production
SB_LOG_LEVEL=INFO
SB_LLM_MODEL=qwen3:4b
SB_OLLAMA_BASE_URL=http://ollama:11434
SB_REDIS_URL=redis://redis:6379/0
SB_RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
SB_CACHE_TTL_SECONDS=900
SB_CHECKPOINT_STORE=postgres
SB_SHARED_STATE_STORE=redis
SB_QDRANT_URL=http://qdrant:6333
SB_MCP_SERVERS=["desk","notes","market"]
SB_MARKET_API_URL=https://market:8100
SB_MARKET_CA_FILE=/certs/ca.crt
SB_MARKET_CLIENT_CERT=/certs/api-client.crt
SB_MARKET_CLIENT_KEY=/certs/api-client.key
SB_SECRETS_DIR=/run/secrets/desk
